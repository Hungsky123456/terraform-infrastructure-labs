
# Terraform local working directories
.terraform/

# Terraform State
*.tfstate
*.tfstate.*

# Terraform lock information
.terraform.tfstate.lock.info

# Terraform crash logs
crash.log
crash.*.log

# Saved Terraform plans
*.tfplan
*.tfplan.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Generated server configuration files (LAB06)
server-*.txt

# Sensitive variable files
*.tfvars.secret
*.auto.tfvars.secret

# Common Terraform secret filenames
secrets.tfvars
secrets.auto.tfvars
*.secret.tfvars
*.secret.auto.tfvars