<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ nginx_site_title }}</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            background: #0f172a;
            color: #f8fafc;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 40px 20px;
        }

        .container {
            max-width: 850px;
            margin: auto;
        }

        .header {
            color: #38bdf8;
            font-size: 14px;
            letter-spacing: 2px;
        }

        h1 {
            font-size: 34px;
        }

        .status {
            color: #4ade80;
            margin-bottom: 30px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 10px;
            padding: 24px;
        }

        .label {
            color: #94a3b8;
            font-size: 12px;
            margin-bottom: 12px;
        }

        .value {
            font-size: 20px;
            overflow-wrap: anywhere;
        }

        footer {
            color: #94a3b8;
            text-align: center;
            margin-top: 35px;
            padding-top: 20px;
            border-top: 1px solid #334155;
        }

        @media (max-width: 600px) {
            .grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
<div class="container">

    <div class="header">
        LAB10 / INFRASTRUCTURE AUTOMATION
    </div>

    <h1>Automated Web Server</h1>

    <div class="status">
        ● Deployment successful
    </div>

    <div class="grid">

        <div class="card">
            <div class="label">ENVIRONMENT</div>
            <div class="value">{{ nginx_environment }}</div>
        </div>

        <div class="card">
            <div class="label">HOSTNAME</div>
            <div class="value">{{ ansible_hostname }}</div>
        </div>

        <div class="card">
            <div class="label">IP ADDRESS</div>
            <div class="value">{{ ansible_host }}</div>
        </div>

        <div class="card">
            <div class="label">OPERATING SYSTEM</div>
            <div class="value">
                {{ ansible_distribution }}
                {{ ansible_distribution_version }}
            </div>
        </div>

        <div class="card">
            <div class="label">VIRTUAL CPU</div>
            <div class="value">
                {{ ansible_processor_vcpus }} vCPU
            </div>
        </div>

        <div class="card">
            <div class="label">MEMORY</div>
            <div class="value">
                {{ ansible_memtotal_mb }} MB
            </div>
        </div>

    </div>

    <footer>
        Terraform · Ansible · Nginx · VMware vSphere
        <p>Managed by Ansible | LAB10</p>
    </footer>

</div>
</body>
</html>
